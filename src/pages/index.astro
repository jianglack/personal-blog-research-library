---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const posts = getSortedPosts((await getCollection("posts")).filter(postFilter));

function getPostCategory(post: (typeof posts)[number]) {
  const text = [
    post.data.title,
    post.data.description,
    ...post.data.tags,
    ...post.data.topics,
  ]
    .join(" ")
    .toLowerCase();

  if (/llm|ai|\u5927\u6a21\u578b|\u63a8\u7406|reasoning|compute/.test(text)) {
    return "AI";
  }
  if (/system|systems|\u5de5\u7a0b|\u67b6\u6784|cloudflare|astro/.test(text)) {
    return "Systems";
  }
  if (
    /writing|\u8868\u8fbe|\u6f14\u8bb2|\u6c9f\u901a|\u535a\u5ba2|write/.test(
      text
    )
  ) {
    return "Writing";
  }
  if (/planning|\u89c4\u5212|\u590d\u76d8|plan/.test(text)) return "Planning";
  return "Writing";
}

function getPostExcerpt(description: string) {
  const compact = description.replace(/\s+/g, " ").trim();
  return compact.length > 116 ? `${compact.slice(0, 116).trim()}...` : compact;
}

const categories = ["AI", "Systems", "Writing", "Planning"] as const;
const categoryCounts = Object.fromEntries(
  categories.map(category => [
    category,
    posts.filter(post => getPostCategory(post) === category).length,
  ])
) as Record<(typeof categories)[number], number>;

const topicButtons = [
  { label: "All", count: posts.length },
  ...categories.map(category => ({
    label: category,
    count: categoryCounts[category],
  })),
];

const homePath = getRelativeLocaleUrl(locale, "");
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
---

<Layout>
  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <div class="mag-frame">
      <section
        class="grid grid-cols-1 items-center gap-5 border-b border-(--mag-ink) p-5 sm:grid-cols-[7rem_1fr]"
      >
        <img
          src={getAssetPath("avatar.png")}
          alt="Louis avatar"
          width="112"
          height="112"
          class="h-28 w-28 border border-(--mag-ink) bg-white object-cover"
          decoding="async"
          loading="eager"
        />
        <h1 class="mag-heavy text-[clamp(3rem,7vw,5.75rem)] leading-[.9]">
          Louis
        </h1>
      </section>

      <section
        class="border-b border-(--mag-ink) px-5 py-4 sm:px-8"
        aria-label="Post topic filter"
      >
        <div class="flex flex-wrap gap-3">
          {
            topicButtons.map((topic, index) => (
              <button
                type="button"
                class="mag-topic-button mag-heavy"
                data-topic-filter={topic.label}
                data-active={index === 0 ? "true" : "false"}
              >
                <span class="mag-topic-label">{topic.label}</span>
                <span class="mag-topic-count">{topic.count}</span>
              </button>
            ))
          }
        </div>
      </section>

      <section id="posts" class="px-5 pt-6 pb-1 sm:px-6">
        <h2 class="mag-section-title mag-heavy">Posts</h2>
        <div class="mag-post-list">
          {
            posts.map((post, index) => {
              const primaryTag = getPostCategory(post);
              return (
                <article
                  class="mag-post-item grid grid-cols-1 gap-4 py-6 sm:grid-cols-[9.5rem_1fr_7rem] sm:gap-6"
                  data-topic={primaryTag}
                  data-visible-separator={
                    index < posts.length - 1 ? "true" : "false"
                  }
                >
                  <div class="text-sm leading-6 text-(--mag-muted) uppercase">
                    <time datetime={post.data.pubDatetime.toISOString()}>
                      {formatDate(post.data.pubDatetime)}
                    </time>
                  </div>
                  <div>
                    <a href={getPostUrl(post.id, post.filePath, locale)}>
                      <h3 class="mb-2 text-[clamp(1.55rem,3vw,2.375rem)] leading-[1.06] font-normal text-(--mag-ink)">
                        {post.data.title}
                      </h3>
                    </a>
                    <p class="mag-post-description max-w-2xl text-[0.95rem] leading-7 text-(--mag-muted)">
                      {getPostExcerpt(post.data.description)}
                    </p>
                  </div>
                  <span class="mag-tag">{primaryTag}</span>
                </article>
              );
            })
          }
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }

    const filterButtons = document.querySelectorAll<HTMLButtonElement>(
      "[data-topic-filter]"
    );
    const postList = document.querySelector<HTMLElement>(".mag-post-list");
    const postItems = document.querySelectorAll<HTMLElement>("[data-topic]");

    function updateVisiblePosts(filter: string) {
      postItems.forEach(item => {
        const visible = filter === "All" || item.dataset.topic === filter;
        item.hidden = !visible;
        item.dataset.visibleSeparator = "false";
      });

      const visibleItems = Array.from(postItems).filter(item => !item.hidden);
      if (postList) {
        postList.dataset.empty = String(visibleItems.length === 0);
      }

      visibleItems.slice(0, -1).forEach(item => {
        item.dataset.visibleSeparator = "true";
      });
    }

    updateVisiblePosts("All");

    filterButtons.forEach(button => {
      button.addEventListener("click", () => {
        const filter = button.dataset.topicFilter ?? "All";

        filterButtons.forEach(item => {
          item.dataset.active = String(item === button);
        });

        updateVisiblePosts(filter);
      });
    });
  });
</script>
