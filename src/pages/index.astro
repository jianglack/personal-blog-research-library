---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ContentList from "@/components/ContentList.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import { filterPublicEntries, sortByDateDesc } from "@/utils/researchLibrary";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const { posts: postsConfig } = config;
const locale = Astro.currentLocale ?? config.site.lang;

const topics = filterPublicEntries(await getCollection("topics"))
  .filter(topic => topic.data.featured)
  .map(topic => ({
    href: getRelativeLocaleUrl(locale, `topics/${topic.id}`),
    title: topic.data.title,
    description: topic.data.description,
    meta: topic.data.tags.join(" / "),
  }));

const posts = getSortedPosts((await getCollection("posts")).filter(postFilter))
  .slice(0, postsConfig.perIndex)
  .map(post => ({
    href: getPostUrl(post.id, post.filePath, locale),
    title: post.data.title,
    description: post.data.description,
    meta: post.data.tags.join(" / "),
  }));

const resources = sortByDateDesc(
  filterPublicEntries(await getCollection("resources"))
)
  .slice(0, 4)
  .map(resource => ({
    href: getRelativeLocaleUrl(locale, `resources/${resource.id}`),
    title: resource.data.title,
    description: resource.data.description,
    meta: [resource.data.type, ...resource.data.tags].join(" / "),
  }));

const series = filterPublicEntries(await getCollection("series")).map(item => ({
  href: getRelativeLocaleUrl(locale, `series/${item.id}`),
  title: item.data.title,
  description: item.data.description,
  meta: `${item.data.posts.length} 篇文章`,
}));

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="intro" class="border-border border-b pt-8 pb-8">
      <div
        class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between"
      >
        <div class="max-w-2xl">
          <h1 class="my-4 text-4xl font-bold sm:my-8 sm:text-5xl">
            LouisJiang
          </h1>
          <p>记录技术学习、博客写作和自我感想随笔。</p>
        </div>
        <div class="flex items-center gap-4 sm:flex-col sm:items-end">
          <img
            src={getAssetPath("avatar.jpg")}
            alt="louis 的头像"
            width="112"
            height="112"
            class="border-border size-24 shrink-0 rounded-full border object-cover sm:size-28"
            decoding="async"
            loading="eager"
          />
          <a
            target="_blank"
            href={getAssetPath("rss.xml")}
            class="inline-block"
            aria-label="RSS 订阅"
            title="RSS 订阅"
          >
            <IconRss
              width={20}
              height={20}
              class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
            />
            <span class="sr-only">RSS 订阅</span>
          </a>
        </div>
      </div>
    </section>

    <section class="border-border border-b py-8">
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-semibold tracking-wide">精选主题</h2>
        <LinkButton href={getRelativeLocaleUrl(locale, "topics")}>
          全部主题
        </LinkButton>
      </div>
      <ContentList items={topics} emptyText="还没有精选主题。" />
    </section>

    <section class="border-border border-b py-8">
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-semibold tracking-wide">最新文章</h2>
        <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
          全部文章
        </LinkButton>
      </div>
      <ContentList items={posts} emptyText="还没有文章。" />
    </section>

    <section class="border-border border-b py-8">
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-semibold tracking-wide">近期资源</h2>
        <LinkButton href={getRelativeLocaleUrl(locale, "resources")}>
          全部资源
        </LinkButton>
      </div>
      <ContentList items={resources} emptyText="还没有资源。" />
    </section>

    <section class="py-8">
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-semibold tracking-wide">系列</h2>
        <LinkButton href={getRelativeLocaleUrl(locale, "series")}>
          全部系列
        </LinkButton>
      </div>
      <ContentList items={series} emptyText="还没有系列。" />
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
