---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconX from "@/assets/icons/IconX.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (config.features.search !== "pagefind" && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const backUrl = config.features.showBackButton
  ? `${Astro.url.pathname}`
  : getRelativeLocaleUrl(locale, "");

const pagefindBundlePath = getAssetPath("pagefind/");
const posts = getSortedPosts((await getCollection("posts")).filter(postFilter));

function getPostExcerpt(description: string) {
  const compact = description.replace(/\s+/g, " ").trim();
  return compact.length > 116 ? `${compact.slice(0, 116).trim()}...` : compact;
}

const postSearchData = posts.map(post => ({
  url: getPostUrl(post.id, post.filePath, locale),
  title: post.data.title,
  description: getPostExcerpt(post.data.description),
}));

const safePostSearchData = JSON.stringify(postSearchData).replace(
  /</g,
  "\\u003c"
);
---

<Layout title={`Search | ${config.site.title}`}>
  <Header />

  <main id="main-content" class="app-layout">
    <div class="mag-frame">
      <section class="px-5 py-7 sm:px-6 sm:py-9">
        <h1 class="mag-section-title mag-heavy">Search</h1>
        <p class="mb-6 text-sm leading-6 text-(--mag-muted)">
          Search posts by title, description, and note content.
        </p>

        <div
          id="post-search"
          transition:persist
          data-backurl={backUrl}
          data-bundle-path={pagefindBundlePath}
        >
          <form class="mag-search-form" role="search" autocomplete="off">
            <IconSearch class="mag-search-icon" aria-hidden="true" />
            <input
              id="post-search-input"
              class="mag-search-input"
              type="search"
              enterkeyhint="search"
              spellcheck="false"
              placeholder="Search posts"
              aria-label="Search posts"
            />
            <button
              type="button"
              class="mag-search-clear"
              aria-label="Clear search"
              hidden
            >
              <IconX aria-hidden="true" />
            </button>
          </form>

          <p class="mag-search-message" data-search-message>
            Type to search posts.
          </p>
          <div class="mag-search-results" data-search-results></div>
        </div>

        <script
          is:inline
          type="application/json"
          id="post-search-data"
          set:html={safePostSearchData}
        />
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  type PostSearchItem = {
    url: string;
    title: string;
    description: string;
  };

  type PagefindResultData = {
    url: string;
    excerpt?: string;
    meta?: {
      title?: string;
    };
  };

  type PagefindModule = {
    search: (term: string) => Promise<{
      results: Array<{
        data: () => Promise<PagefindResultData>;
      }>;
    }>;
  };

  function initPostSearch() {
    const root = document.querySelector<HTMLElement>("#post-search");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const form = root.querySelector<HTMLFormElement>(".mag-search-form");
    const input = root.querySelector<HTMLInputElement>("#post-search-input");
    const clearButton =
      root.querySelector<HTMLButtonElement>(".mag-search-clear");
    const message = root.querySelector<HTMLElement>("[data-search-message]");
    const results = root.querySelector<HTMLElement>("[data-search-results]");
    const dataScript =
      document.querySelector<HTMLScriptElement>("#post-search-data");
    const bundlePath = root.dataset.bundlePath;

    if (
      !form ||
      !input ||
      !clearButton ||
      !message ||
      !results ||
      !bundlePath
    ) {
      return;
    }

    const formEl = form;
    const inputEl = input;
    const clearButtonEl = clearButton;
    const messageEl = message;
    const resultsEl = results;
    const pagefindBundlePath = bundlePath;

    const posts = dataScript?.textContent
      ? (JSON.parse(dataScript.textContent) as PostSearchItem[])
      : [];
    const postsByPath = new Map(
      posts.map(post => [normalizePath(post.url), post])
    );
    const params = new URLSearchParams(window.location.search);
    let pagefindModule: PagefindModule | null = null;
    let searchTimer: number | undefined;

    inputEl.value = params.get("q") ?? "";

    formEl.addEventListener("submit", event => {
      event.preventDefault();
      void runSearch(inputEl.value);
    });

    inputEl.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        void runSearch(inputEl.value);
      }, 120);
    });

    clearButtonEl.addEventListener("click", () => {
      inputEl.value = "";
      void runSearch("");
      inputEl.focus();
    });

    void runSearch(inputEl.value);

    async function loadPagefind() {
      if (pagefindModule) return pagefindModule;

      if (import.meta.env.DEV) {
        throw new Error("Pagefind is only available after building the site.");
      }

      const importPagefind = new Function("url", "return import(url)") as (
        url: string
      ) => Promise<PagefindModule>;
      const loaded = await importPagefind(`${pagefindBundlePath}pagefind.js`);
      pagefindModule = loaded;
      return loaded;
    }

    async function runSearch(rawTerm: string) {
      const term = rawTerm.trim();
      syncUrl(term);
      clearButtonEl.hidden = term.length === 0;
      resultsEl.innerHTML = "";

      if (!term) {
        messageEl.textContent = "Type to search posts.";
        return;
      }

      messageEl.textContent = "Searching...";

      try {
        const pagefind = await loadPagefind();
        const search = await pagefind.search(term);
        const rows = await Promise.all(
          search.results.slice(0, 40).map(async result => result.data())
        );
        const postRows = rows
          .map(data => {
            const post = postsByPath.get(normalizePath(data.url));
            if (!post) return null;
            return {
              ...post,
              url: data.url,
            };
          })
          .filter((item): item is PostSearchItem => Boolean(item));

        renderResults(term, postRows);
      } catch (error) {
        console.error("Post search failed", error);
        messageEl.textContent =
          "Search index is unavailable. Run pnpm build before previewing search.";
      }
    }

    function renderResults(term: string, items: PostSearchItem[]) {
      const count = items.length;
      messageEl.textContent =
        count === 1 ? `1 post for "${term}"` : `${count} posts for "${term}"`;

      if (count === 0) {
        resultsEl.innerHTML = `
          <p class="mag-search-empty">No matching posts.</p>
        `;
        return;
      }

      resultsEl.innerHTML = items
        .map(
          item => `
            <article class="mag-search-result">
              <div>
                <a class="mag-search-result-title" href="${escapeHtml(item.url)}">
                  ${escapeHtml(item.title)}
                </a>
                <p class="mag-search-result-description">
                  ${escapeHtml(item.description)}
                </p>
              </div>
              <span class="mag-tag">Post</span>
            </article>
          `
        )
        .join("");
    }

    function syncUrl(term: string) {
      const nextParams = new URLSearchParams(window.location.search);
      if (term) {
        nextParams.set("q", term);
      } else {
        nextParams.delete("q");
      }

      const queryString = nextParams.toString();
      const nextUrl = queryString
        ? `${window.location.pathname}?${queryString}`
        : window.location.pathname;
      history.replaceState(history.state, "", nextUrl);

      const backUrl = root?.dataset?.backurl ?? window.location.pathname;
      sessionStorage.setItem(
        "backUrl",
        queryString ? `${backUrl}?${queryString}` : backUrl
      );
    }

    function normalizePath(url: string) {
      const parsed = new URL(url, window.location.origin);
      let path = parsed.pathname;
      try {
        path = decodeURI(path);
      } catch {
        // Keep the browser-normalized path if decoding fails.
      }

      return path.replace(/\/index\.html$/, "").replace(/\/$/, "");
    }

    function escapeHtml(value: string) {
      return value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  }

  document.addEventListener("astro:after-swap", initPostSearch);
  initPostSearch();
</script>

<style is:global>
  #post-search {
    color: var(--mag-ink);
  }

  .mag-search-form {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.875rem;
    border: 1px solid var(--mag-ink);
    background: var(--mag-paper);
    padding: 0.625rem 0.75rem;
  }

  .mag-search-form:focus-within {
    box-shadow: inset 0 0 0 1px var(--mag-ink);
  }

  .mag-search-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--mag-muted);
  }

  .mag-search-input {
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--mag-ink);
    font-size: 1.25rem;
    line-height: 1.4;
    outline: 0;
  }

  .mag-search-input::-webkit-search-cancel-button {
    display: none;
  }

  .mag-search-clear {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--mag-ink);
    background: transparent;
    color: var(--mag-ink);
  }

  .mag-search-clear:hover {
    background: var(--mag-ink);
    color: var(--mag-paper);
  }

  .mag-search-clear[hidden] {
    display: none;
  }

  .mag-search-clear svg {
    width: 1rem;
    height: 1rem;
  }

  .mag-search-message {
    margin: 1.25rem 0 0;
    border-bottom: 1px solid var(--mag-ink);
    padding-bottom: 1rem;
    color: var(--mag-muted);
    font-size: 0.95rem;
  }

  .mag-search-result {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    border-bottom: 1px solid var(--mag-ink);
    padding: 1.375rem 0;
  }

  .mag-search-result:last-child {
    border-bottom: 0;
  }

  .mag-search-result-title {
    color: var(--mag-ink);
    font-size: clamp(1.55rem, 3vw, 2.375rem);
    font-weight: 400;
    line-height: 1.08;
    text-decoration: none;
  }

  .mag-search-result-title:hover {
    color: var(--mag-ink);
    text-decoration: none;
  }

  .mag-search-result-description,
  .mag-search-empty {
    margin-top: 0.5rem;
    max-width: 42rem;
    color: var(--mag-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .mag-search-empty {
    padding: 1.375rem 0;
  }

  #post-search mark {
    background: transparent;
    color: inherit;
  }

  @media (max-width: 640px) {
    .mag-search-result {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
