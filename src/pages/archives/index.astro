---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import ResearchLibraryLayout from "@/layouts/ResearchLibraryLayout.astro";
import config from "@/config";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import { sortByDateDesc } from "@/utils/researchLibrary";

const locale = Astro.currentLocale ?? config.site.lang;
const notFoundUrl = getRelativeLocaleUrl(locale, "404");

if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const posts = sortByDateDesc((await getCollection("posts")).filter(postFilter));
const postsByYear = posts.reduce<Record<string, typeof posts>>(
  (groups, post) => {
    const year = String(post.data.date.getFullYear());
    groups[year] = groups[year] ?? [];
    groups[year].push(post);
    return groups;
  },
  {}
);
const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<ResearchLibraryLayout title="归档" description="按发布时间年份整理的文章。">
  <div class="space-y-8">
    {
      years.map(year => (
        <section>
          <h2 class="mb-3 text-xl font-semibold">{year}</h2>
          <ul class="space-y-2">
            {postsByYear[year].map(post => (
              <li>
                <a
                  class="underline-offset-4 hover:underline"
                  href={getPostUrl(post.id, post.filePath, locale)}
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</ResearchLibraryLayout>
