---
import { getCollection } from "astro:content";
import ContentList from "@/components/ContentList.astro";
import ResearchLibraryLayout from "@/layouts/ResearchLibraryLayout.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import { filterPublicEntries, sortByDateDesc } from "@/utils/researchLibrary";
import { slugifyStr } from "@/utils/slugify";

const locale = Astro.currentLocale;

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).filter(postFilter);
  const resources = filterPublicEntries(await getCollection("resources"));
  const tagsBySlug = new Map<string, string>();

  for (const tag of [
    ...posts.flatMap(post => post.data.tags),
    ...resources.flatMap(resource => resource.data.tags),
  ]) {
    const slug = slugifyStr(tag);
    if (!tagsBySlug.has(slug)) {
      tagsBySlug.set(slug, tag);
    }
  }

  return Array.from(tagsBySlug, ([slug, tagName]) => ({
    params: { tag: slug },
    props: { tag: slug, tagName },
  }));
}

const { tag, tagName } = Astro.props;
const posts = sortByDateDesc((await getCollection("posts")).filter(postFilter))
  .filter(post => post.data.tags.some(postTag => slugifyStr(postTag) === tag))
  .map(post => ({
    href: getPostUrl(post.id, post.filePath, locale),
    title: post.data.title,
    description: post.data.description,
    meta: "文章",
  }));

const resources = filterPublicEntries(await getCollection("resources"))
  .filter(resource =>
    resource.data.tags.some(resourceTag => slugifyStr(resourceTag) === tag)
  )
  .map(resource => ({
    href: `/resources/${resource.id}/`,
    title: resource.data.title,
    description: resource.data.description,
    meta: `资源 / ${resource.data.type}`,
  }));
---

<ResearchLibraryLayout
  title={`标签：${tagName}`}
  description="包含该标签的文章和资源。"
>
  <section class="mb-8">
    <h2 class="mb-3 text-xl font-semibold">文章</h2>
    <ContentList items={posts} emptyText="这个标签下还没有文章。" />
  </section>
  <section>
    <h2 class="mb-3 text-xl font-semibold">资源</h2>
    <ContentList items={resources} emptyText="这个标签下还没有资源。" />
  </section>
</ResearchLibraryLayout>
