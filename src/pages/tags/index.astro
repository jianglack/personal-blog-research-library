---
import { getCollection } from "astro:content";
import ResearchLibraryLayout from "@/layouts/ResearchLibraryLayout.astro";
import { postFilter } from "@/utils/postFilter";
import { filterPublicEntries } from "@/utils/researchLibrary";
import { slugifyStr } from "@/utils/slugify";

const posts = (await getCollection("posts")).filter(postFilter);
const resources = filterPublicEntries(await getCollection("resources"));
const tagsBySlug = new Map<string, string>();

for (const tag of [
  ...posts.flatMap(post => post.data.tags),
  ...resources.flatMap(resource => resource.data.tags),
]) {
  const slug = slugifyStr(tag);
  if (!tagsBySlug.has(slug)) {
    tagsBySlug.set(slug, tag);
  }
}

const tags = Array.from(tagsBySlug, ([slug, tagName]) => ({
  slug,
  tagName,
})).sort((a, b) => a.slug.localeCompare(b.slug));
---

<ResearchLibraryLayout title="标签" description="按标签浏览文章和资源。">
  <ul class="flex flex-wrap gap-2">
    {
      tags.map(({ slug, tagName }) => (
        <li>
          <a
            class="border-border hover:bg-muted/75 rounded border px-2 py-1 text-sm"
            href={`/tags/${slug}/`}
          >
            {tagName}
          </a>
        </li>
      ))
    }
  </ul>
</ResearchLibraryLayout>
