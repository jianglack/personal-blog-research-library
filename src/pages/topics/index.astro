---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import ContentList from "@/components/ContentList.astro";
import ResearchLibraryLayout from "@/layouts/ResearchLibraryLayout.astro";
import config from "@/config";
import { filterPublicEntries } from "@/utils/researchLibrary";
import { postFilter } from "@/utils/postFilter";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = (await getCollection("posts")).filter(postFilter);
const resources = filterPublicEntries(await getCollection("resources"));

function getTopicMeta(topicId: string) {
  const postCount = posts.filter(post => post.data.topics.includes(topicId)).length;
  const resourceCount = resources.filter(resource =>
    resource.data.topics.includes(topicId)
  ).length;

  return resourceCount > 0
    ? `${postCount} posts / ${resourceCount} resources`
    : `${postCount} posts`;
}

const topics = filterPublicEntries(await getCollection("topics"))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, locale))
  .map(topic => ({
    href: getRelativeLocaleUrl(locale, `topics/${topic.id}`),
    title: topic.data.title,
    description: topic.data.description,
    meta: getTopicMeta(topic.id),
  }));
---

<ResearchLibraryLayout
  title="主题"
  description="长期关注的研究方向和学习路径。"
>
  <ContentList items={topics} emptyText="还没有主题。" />
</ResearchLibraryLayout>
