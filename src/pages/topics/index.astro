---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import ContentList from "@/components/ContentList.astro";
import ResearchLibraryLayout from "@/layouts/ResearchLibraryLayout.astro";
import config from "@/config";
import { postFilter } from "@/utils/postFilter";
import { getTopicCategory, topicCategories } from "@/utils/topicCategories";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = (await getCollection("posts")).filter(postFilter);

const topics = topicCategories.map(category => {
  const count = posts.filter(post => getTopicCategory(post.data).slug === category.slug)
    .length;

  return {
    href: getRelativeLocaleUrl(locale, `topics/${category.slug}`),
    title: category.label,
    description: category.description,
    meta: `${count} posts`,
  };
});
---

<ResearchLibraryLayout
  title="Topics"
  description="The main categories used to organize posts on the blog."
>
  <ContentList items={topics} emptyText="No topics yet." />
</ResearchLibraryLayout>
