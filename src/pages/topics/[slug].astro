---
import { getCollection } from "astro:content";
import ContentList from "@/components/ContentList.astro";
import ResearchLibraryLayout from "@/layouts/ResearchLibraryLayout.astro";
import config from "@/config";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import { sortByDateDesc } from "@/utils/researchLibrary";
import {
  getTopicCategory,
  getTopicCategoryBySlug,
  topicCategories,
} from "@/utils/topicCategories";

const locale = Astro.currentLocale ?? config.site.lang;

export function getStaticPaths() {
  return topicCategories.map(category => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const topic = getTopicCategoryBySlug(category.slug) ?? category;
const formatDate = (date: Date) =>
  date.toLocaleDateString(locale === "zh" ? "zh-CN" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

const posts = sortByDateDesc((await getCollection("posts")).filter(postFilter))
  .filter(post => getTopicCategory(post.data).slug === topic.slug)
  .map(post => ({
    href: getPostUrl(post.id, post.filePath, locale),
    title: post.data.title,
    description: post.data.description,
    meta: formatDate(post.data.pubDatetime),
  }));
---

<ResearchLibraryLayout
  title={topic.label}
  description={topic.description}
  lang={locale}
>
  <section class="mb-8 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
    <div class="border-border border p-4">
      <p class="text-foreground/70">Posts</p>
      <strong class="mt-2 block text-3xl">{posts.length}</strong>
    </div>
    <div class="border-border border p-4">
      <p class="text-foreground/70">Match</p>
      <strong class="mt-2 block text-base uppercase">{topic.slug}</strong>
    </div>
  </section>

  <section>
    <h2 class="mb-3 text-xl font-semibold">Posts</h2>
    <ContentList items={posts} emptyText="No posts in this topic yet." />
  </section>
</ResearchLibraryLayout>
