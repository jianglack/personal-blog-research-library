---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { getAssetPath } from "@/utils/withBase";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <main id="main-content" class="app-layout py-8">
    <section class="mag-frame p-6 sm:p-10">
      <div class="mb-8 flex items-center gap-4">
        <img
          src={getAssetPath("avatar.png")}
          alt="Louis"
          width="96"
          height="96"
          class="size-24 border border-[var(--mag-ink)] object-cover"
          decoding="async"
        />
        <div>
          <p class="text-sm font-black text-[var(--mag-red)] uppercase">
            About
          </p>
          <h1 class="text-4xl font-normal text-[var(--mag-ink)]">
            {about.data.title}
          </h1>
        </div>
      </div>

      <article class="app-prose max-w-3xl">
        <Content />
      </article>
    </section>
  </main>

  <Footer />
</Layout>
