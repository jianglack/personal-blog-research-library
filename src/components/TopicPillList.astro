---
interface Props {
  topics: string[];
}

const { topics } = Astro.props;
---

{
  topics.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {topics.map(topic => (
        <li>
          <span class="border-border rounded border px-2 py-1 text-xs">
            {topic}
          </span>
        </li>
      ))}
    </ul>
  )
}
