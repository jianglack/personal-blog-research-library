---
import type { HTMLAttributes } from "astro/types";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = true, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["mag-footer app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="mag-footer-inner">
    <a href="mailto:zslouis8605@gmail.com">zslouis8605@gmail.com</a>
    <a href="https://github.com/jianglack" rel="me noopener noreferrer">
      github.com/jianglack
    </a>
  </div>
</footer>
